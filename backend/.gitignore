# ============================================================
# FILE: backend/.gitignore
# PURPOSE: Tells Git which files to NEVER upload to GitHub
# ============================================================

# Never upload passwords or secrets
.env

# Never upload the virtual environment (too large, can be recreated)
venv/
__pycache__/
*.pyc
*.pyo

# Python test cache
.pytest_cache/
.coverage

# Editor files
.vscode/
*.idea

