# Database connection string
# Format: postgresql+psycopg://username:password@localhost:5432/database_name
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/billing

# JWT Secret Key - change this to a long random string in production
SECRET_KEY=change-this-to-a-long-random-secret-key-before-going-live

# Token expiration time in minutes (480 mins = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
